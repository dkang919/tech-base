# 가상환경 (제일 중요)
venv/
.venv/
env/
.env/

# 파이썬 찌꺼기
__pycache__/
*.pyc
*.pyo
*.pyd

# MkDocs 빌드 결과물 (이건 깃허브에 올릴 필요 없음)
site/

# 비밀정보 (NOTION_TOKEN 등)
# 주의: 위의 `.env/`는 디렉터리만 막는다. 파일을 막으려면 슬래시 없는 패턴이 필요하다.
# 예외를 두지 않는다. .env.example 같은 템플릿 파일도 커밋 대상이 되는 순간
# 실수로 실제 토큰이 들어갈 수 있어서, 설정 예시는 tools/README.md 에만 둔다.
.env
.env.*

# 임시 확인/디버깅 스크립트 전용 폴더 (핵심 코드와 섞지 않는다)
tools/debug/

# 운영체제/에디터 잡동사니
.DS_Store
.vscode/
.idea/